#!/bin/sh
set -eu

directory=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
if [ -n "${JAVA_HOME:-}" ]; then
  java_command="$JAVA_HOME/bin/java"
else
  java_command=java
fi
# 小规模联机使用串行 GC 和较小初始堆，存档处理仍可按需使用最多 512 MiB 堆。
exec "$java_command" -XX:+UseSerialGC -Xms16m -Xmx512m -jar "$directory/worldrelay-server.jar" "$@"
